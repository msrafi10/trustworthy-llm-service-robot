<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="depth_camera" params="prefix:=''">

    <!-- Intel RealSense D435 -->
    <joint name="${prefix}realsense_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}realsense_link"/>
      <origin xyz="0.1 0.0 0.115" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}realsense_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
        <material name="realsense_grey">
          <color rgba="0.35 0.35 0.35 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- D435 Depth Optical Frame -->
    <joint name="${prefix}realsense_depth_optical_joint" type="fixed">
      <parent link="${prefix}realsense_link"/>
      <child link="${prefix}realsense_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <link name="${prefix}realsense_depth_optical_frame"/>

    <!-- D435 Color Optical Frame -->
    <joint name="${prefix}realsense_color_optical_joint" type="fixed">
      <parent link="${prefix}realsense_link"/>
      <child link="${prefix}realsense_color_optical_frame"/>
      <origin xyz="0 0.015 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <link name="${prefix}realsense_color_optical_frame"/>

    <!-- Gazebo Material -->
    <gazebo reference="${prefix}realsense_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- D435 Depth Camera Sensor -->
    <gazebo reference="${prefix}realsense_link">
      <sensor type="depth" name="realsense_d435_depth">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.105</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="realsense_depth_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace/>
            <remapping>image_raw:=camera/color/image_raw</remapping>
            <remapping>camera_info:=camera/color/camera_info</remapping>
            <remapping>depth/image_raw:=camera/depth/image_raw</remapping>
            <remapping>depth/camera_info:=camera/depth/camera_info</remapping>
            <remapping>points:=camera/depth/points</remapping>
          </ros>
          <camera_name>realsense_d435</camera_name>
          <frame_name>${prefix}realsense_depth_optical_frame</frame_name>
          <hack_baseline>0.05</hack_baseline>
          <min_depth>0.105</min_depth>
          <max_depth>10.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>